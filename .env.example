# ==============================================================================
# MISTHOS — Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Security
# Generate a strong 32+ character random string for production
SESSION_SECRET=misthos-production-session-secret-change-me-in-prod-xyz-987
SESSION_COOKIE_NAME=misthos_session

# Arc Testnet Configuration (Circle Layer-1 Network)
# Official Arc Testnet Chain ID: 5042002
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
# Working public RPC for Arc testnet. The canteen-hosted endpoint (arc-node.thecanteenapp.com)
# returns 405 for JSON-RPC, so we default to the public SolidRPC gateway.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.solidrpc.io/public/evm/5042002
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# Arc Testnet Native USDC Token Address (6 Decimals)
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000

# Misthos Escrow Smart Contract Address on Arc Testnet
# Populated ONLY after running `npm run deploy:arc` with a funded deployer key.
# If this points to an address with no deployed code, funding/settlement will correctly fail.
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=

# Dual-Agent Oracle & Treasury Signer (Server-Side ONLY - Never expose in frontend!)
# This dedicated EVM private key signs EIP-712 AttestationPayloads server-side.
# The matching address must be set as the oracle at contract deployment and MUST hold
# testnet USDC for gas if it also deploys. Get testnet USDC from TestMint / the Arc faucet.
# Read from ORACLE_PRIVATE_KEY by src/lib/agents/treasury-agent.ts.
ORACLE_PRIVATE_KEY=
ORACLE_SIGNER_PRIVATE_KEY=
ORACLE_SIGNER_ADDRESS=

# AI Agent Engine (Agent A oracle + MIZO) - provider-agnostic
# Default provider is OpenRouter (one key, any model, free tiers available).
# Users can also configure their own provider per-account in Settings > AI Agent.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_API_KEY=
# Or provider-specific keys:
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# GitHub API Integration (For private repository artifact checks)
GITHUB_ACCESS_TOKEN=
